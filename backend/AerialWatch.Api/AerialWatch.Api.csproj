<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Presentation layer: HTTP controllers, auth, error handling, composition root. No business logic here.
       Microsoft.EntityFrameworkCore.Design is needed because this is the dotnet-ef startup project. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="6.6.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Program.cs wires Application + Infrastructure; controllers use only Contracts (checked by ArchitectureTests). -->
    <ProjectReference Include="..\AerialWatch.Contracts\AerialWatch.Contracts.csproj" />
    <ProjectReference Include="..\AerialWatch.Application\AerialWatch.Application.csproj" />
    <ProjectReference Include="..\AerialWatch.Infrastructure\AerialWatch.Infrastructure.csproj" />
  </ItemGroup>

</Project>
