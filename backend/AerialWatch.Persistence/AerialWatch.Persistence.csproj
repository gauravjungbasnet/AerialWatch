<Project Sdk="Microsoft.NET.Sdk">

  <!-- Persistence (data) layer: EF Core + Microsoft SQL Server. DbContext, table configurations, migrations,
       repositories and unit of work. Implements the repository interfaces from Application. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Lets dotnet ef read the API's appsettings.json (DesignTimeDbContextFactory). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AerialWatch.Application\AerialWatch.Application.csproj" />
  </ItemGroup>

</Project>
