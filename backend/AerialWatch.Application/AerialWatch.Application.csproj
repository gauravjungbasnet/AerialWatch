<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application layer: implements the service interfaces in Contracts (use cases, validation, mapping) and defines the
       ports outer layers implement (Abstractions/: repositories, unit of work, clock). Depends only on Contracts and
       Domain. No EF Core, no ASP.NET. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only for IServiceCollection in DependencyInjection.cs. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AerialWatch.Contracts\AerialWatch.Contracts.csproj" />
    <ProjectReference Include="..\AerialWatch.Domain\AerialWatch.Domain.csproj" />
  </ItemGroup>

</Project>
